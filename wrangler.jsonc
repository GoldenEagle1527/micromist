{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "micromist",
  // Workers Free: Static Assets + a thin Worker + SQLite-backed Durable Objects.
  // Do not add D1, KV, or R2 bindings to this project.
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./worker/index.ts",
  "assets": {
    // Vite plugin rewrites this in the generated dist wrangler.json to the
    // client build output (typically ./dist/client). Kept here so the intent
    // is explicit if you inspect or deploy the built config.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "micromist.goldeneaglepersonal.dpdns.org",
      "custom_domain": true
    }
  ]
}
