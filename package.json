{
  "name": "micromist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "\u5fae\u6e3a / micromist \u2014 open-source browser game platform on Cloudflare Workers",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "cf-typegen": "wrangler types --include-runtime false",
    "deploy:staging": "npm run build && node scripts/patch-staging-wrangler.mjs && wrangler deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.37.0"
  }
}
