{
  "name": "micromist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "微渺 / micromist — open-source browser game platform on Cloudflare Workers",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test:explosive-seat": "esbuild scripts/explosive-chess-seat-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ec-seat-test.mjs --log-level=warning && node node_modules/.cache/ec-seat-test.mjs",
    "test:chroma-agent": "esbuild scripts/chroma-slide-agent-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/chroma-agent-test.mjs --log-level=warning && node node_modules/.cache/chroma-agent-test.mjs",
    "test:explosive-agent": "esbuild scripts/explosive-chess-agent-observe-test.ts --bundle --platform=node --outfile=node_modules/.cache/ec-agent-observe-test.cjs --log-level=warning && node node_modules/.cache/ec-agent-observe-test.cjs",
    "test:explosive-handoff": "esbuild scripts/explosive-chess-agent-handoff-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ec-agent-handoff-test.mjs --log-level=warning && node node_modules/.cache/ec-agent-handoff-test.mjs",
    "test:agent": "esbuild scripts/agent-platform-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/agent-platform-test.mjs --log-level=warning && node node_modules/.cache/agent-platform-test.mjs",
    "test:explosive-mcp": "esbuild scripts/explosive-chess-mcp-stdio.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ec-mcp-stdio.mjs --log-level=warning && esbuild scripts/explosive-chess-mcp-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ec-mcp-test.mjs --log-level=warning && node node_modules/.cache/ec-mcp-test.mjs",
    "mcp:explosive-chess": "esbuild scripts/explosive-chess-mcp-stdio.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ec-mcp-stdio.mjs --log-level=warning && node node_modules/.cache/ec-mcp-stdio.mjs",
    "test:room-presence": "esbuild scripts/game-room-presence-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/game-room-presence-test.mjs --log-level=warning && node node_modules/.cache/game-room-presence-test.mjs",
    "cf-typegen": "wrangler types --include-runtime false",
    "deploy:staging": "npm run build -- --mode staging && node scripts/patch-staging-wrangler.mjs && wrangler deploy"
  },
  "dependencies": {
    "@algorithm.ts/gomoku": "^4.0.5",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.37.0"
  }
}
