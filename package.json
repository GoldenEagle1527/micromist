{
  "name": "micromist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "微渺 / micromist — open-source browser game platform on Cloudflare Workers",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sfx-sync.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test:terrain-info": "esbuild scripts/deep-march-terrain-info-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-terrain-info-test.cjs --log-level=warning && node node_modules/.cache/dm-terrain-info-test.cjs",
    "test:collision": "esbuild scripts/deep-march-collision-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-collision-test.cjs --log-level=warning && node node_modules/.cache/dm-collision-test.cjs",
    "test:wasm": "esbuild scripts/deep-march-wasm-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-wasm-test.cjs --log-level=warning && node node_modules/.cache/dm-wasm-test.cjs",
    "test:streaming": "esbuild scripts/deep-march-streaming-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-streaming-test.cjs --log-level=error && node node_modules/.cache/dm-streaming-test.cjs",
    "test:bricks": "esbuild scripts/deep-march-bricks-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-bricks-test.cjs --log-level=warning && node node_modules/.cache/dm-bricks-test.cjs",
    "test:detail": "esbuild scripts/deep-march-detail-test.ts --bundle --platform=node --external:@webgpu/glslang --outfile=node_modules/.cache/dm-detail-test.cjs --log-level=warning && node node_modules/.cache/dm-detail-test.cjs",
    "test:shaders": "esbuild scripts/deep-march-shaders-test.ts --bundle --platform=node --external:@webgpu/glslang --outfile=node_modules/.cache/dm-shaders-test.cjs --log-level=warning && node node_modules/.cache/dm-shaders-test.cjs",
    "test:fog": "esbuild scripts/deep-march-fog-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-fog-test.cjs --log-level=warning && node node_modules/.cache/dm-fog-test.cjs",
    "test:sonar": "esbuild scripts/deep-march-sonar-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-sonar-test.cjs --log-level=warning && node node_modules/.cache/dm-sonar-test.cjs",
    "test:materials": "esbuild scripts/deep-march-materials-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-materials-test.cjs --log-level=warning && node node_modules/.cache/dm-materials-test.cjs",
    "test:loading": "esbuild scripts/deep-march-loading-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-loading-test.cjs --log-level=warning && node node_modules/.cache/dm-loading-test.cjs",
    "test:regionweights": "esbuild scripts/deep-march-regionweights-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-regionweights-test.cjs --log-level=warning && node node_modules/.cache/dm-regionweights-test.cjs",
    "test:refine": "esbuild scripts/deep-march-refine-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-refine-test.cjs --log-level=warning && node node_modules/.cache/dm-refine-test.cjs",
    "test:audio": "esbuild scripts/deep-march-audio-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-audio-test.cjs --define:import.meta.env.BASE_URL='\"/\"' --log-level=warning && node node_modules/.cache/dm-audio-test.cjs",
    "test:sfx": "node scripts/deep-march-sfx-sync-test.mjs",
    "test:free-baseline": "esbuild scripts/deep-march-free-baseline-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-free-baseline-test.cjs --log-level=warning && node node_modules/.cache/dm-free-baseline-test.cjs",
    "test:ledger": "esbuild scripts/deep-march-ledger-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-ledger-test.cjs --log-level=warning && node node_modules/.cache/dm-ledger-test.cjs",
    "test:save": "esbuild scripts/deep-march-save-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-save-test.cjs --log-level=warning && node node_modules/.cache/dm-save-test.cjs",
    "test:modes": "esbuild scripts/deep-march-modes-test.ts --bundle --platform=node --format=esm --external:esbuild --outfile=node_modules/.cache/dm-modes-test.mjs --log-level=warning && node node_modules/.cache/dm-modes-test.mjs",
    "test:regions": "esbuild scripts/deep-march-regions-test.ts --bundle --platform=node --outfile=node_modules/.cache/dm-regions-test.cjs --log-level=warning && node node_modules/.cache/dm-regions-test.cjs",
    "cf-typegen": "wrangler types --include-runtime false",
    "deploy:staging": "npm run build && node scripts/patch-staging-wrangler.mjs && wrangler deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "@webgpu/glslang": "^0.0.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.37.0"
  }
}
